{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=memoria;Username=memoria;Password=___"
  },
  "Jwt": {
    "Issuer": "memoria",
    "Audience": "memoria-api",
    "SigningKey": "___",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "VerificationCode": {
    "TtlMinutesForLinking": 5,
    "TtlMinutesForEmail": 10,
    "MaxAttempts": 5
  },
  "Email": {
    "ApiKey": "",
    "FromAddress": "Memoria <noreply@memoria.futuricon.net>"
  },
  "Telegram": {
    "BotToken": "___",
    "BotUsername": "memoria_bot",
    "SpaUrl": "https://memoria.futuricon.net"
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/memoria-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Reminders": {
    "Intervals": ["00:10:00", "01:00:00", "1.00:00:00", "3.00:00:00", "7.00:00:00", "14.00:00:00", "30.00:00:00", "90.00:00:00"],
    "HardRetryInterval": "01:00:00"
  },
  "Cards": {
    "SoftDeleteRetentionDays": 90,
    "PurgeCronExpression": "0 4 * * *"
  },
  "Ai": {
    "Provider": "Claude",
    "ApiKey": "",
    "BaseUrl": "",
    "GradingModel": "",
    "ValidationModel": "",
    "MaxTokens": 1024,
    "TimeoutSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000",
      "http://localhost:4200",
      "https://memoria.futuricon.net"
    ]
  },
  "OAuth": {
    "Google": { "ClientId": "___", "ClientSecret": "___" },
    "GitHub": { "ClientId": "___", "ClientSecret": "___" }
  },
  "Hangfire": {
    "AllowedEmails": []
  },
  "Admin": {
    "Emails": []
  },
  "AllowedHosts": "*"
}
