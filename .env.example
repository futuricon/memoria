# Memoria — runtime config for docker-compose --profile full
#
# Copy this file to `.env` and fill in the blanks. Real secrets must never
# end up in git — `.env` is gitignored.

# ---------- Database ----------
POSTGRES_PASSWORD=memoria_local

# ---------- JWT ----------
# Generate with: openssl rand -base64 48
# HS256 requires at least 32 bytes after UTF-8 decoding.
JWT_SIGNING_KEY=replace_me_with_at_least_32_byte_random_string

# ---------- Telegram bot (BotFather) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=memoria_bot

# ---------- OAuth (Hangfire dashboard) ----------
# Configure Google: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:8080/jobs/signin-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Configure GitHub: https://github.com/settings/applications/new
# Authorization callback URL: http://localhost:8080/jobs/signin-github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email allowed to enter Hangfire dashboard after OAuth sign-in.
HANGFIRE_ADMIN_EMAIL=you@example.com

# ---------- Frontend ----------
SPA_ORIGIN=http://localhost:5173

# ---------- Environment ----------
ASPNETCORE_ENVIRONMENT=Development
