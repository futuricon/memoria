# Memoria — runtime config for docker-compose --profile full
#
# Copy this file to `.env` and fill in the blanks. Real secrets must never
# end up in git — `.env` is gitignored.

# ---------- Database ----------
POSTGRES_PASSWORD=memoria_local

# ---------- JWT ----------
# Generate with: openssl rand -base64 48
# HS256 requires at least 32 bytes after UTF-8 decoding.
JWT_SIGNING_KEY=replace_me_with_at_least_32_byte_random_string

# ---------- Telegram bot (BotFather) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=memoria_bot

# ---------- OAuth (Hangfire dashboard) ----------
# Configure Google: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:8080/jobs/signin-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Configure GitHub: https://github.com/settings/applications/new
# Authorization callback URL: http://localhost:8080/jobs/signin-github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email allowed to enter Hangfire dashboard after OAuth sign-in.
HANGFIRE_ADMIN_EMAIL=you@example.com

# ---------- AI grading (Claude / DeepSeek) ----------
# AI_PROVIDER = Claude | DeepSeek. Empty key → grading/validation degrade
# fail-open (cards still created, answers not auto-graded; the app still boots).
# Leave BASE_URL / models empty to use the provider defaults:
#   Claude   → claude-sonnet-4-6 @ api.anthropic.com   (key: console.anthropic.com)
#   DeepSeek → deepseek-chat      @ api.deepseek.com    (key: platform.deepseek.com)
# DeepSeek is ~10x cheaper: set AI_PROVIDER=DeepSeek and AI_API_KEY=<deepseek key>.
AI_PROVIDER=Claude
AI_API_KEY=
AI_BASE_URL=
AI_GRADING_MODEL=
AI_VALIDATION_MODEL=

# ---------- Frontend ----------
SPA_ORIGIN=http://localhost:5173

# ---------- Logging ----------
# Crank to Debug to analyze the app for a few days, then revert.
# WARNING: don't keep LOG_LEVEL_MICROSOFT / _ASPNETCORE / _SYSTEM on Debug for
# more than a few hours — EF logs every SQL with parameters, ASP.NET logs every
# pipeline step. Disk fills fast.
LOG_LEVEL=Information
LOG_LEVEL_MICROSOFT=Warning
LOG_LEVEL_ASPNETCORE=Warning
LOG_LEVEL_SYSTEM=Warning

# ---------- Environment ----------
ASPNETCORE_ENVIRONMENT=Development
